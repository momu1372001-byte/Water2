  "sentences": [
    { "id": "s-1", "english": "How are you? I'm fine, thanks.", "translations": { "ar": "كيف حالك؟ أنا بخير، شكراً.", "fr": "Comment ça va ? Je vais bien, merci.", "hi": "आप कैसे हैं? मैं ठीक हूँ, धन्यवाद।" } },
