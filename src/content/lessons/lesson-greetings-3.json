  "grammar": [
    {
      "id": "g-contractions",
      "title": { "ar": "الاختصارات: I'm", "fr": "Les contractions : I'm", "hi": "संक्षिप्त रूप: I'm", "en": "Contractions: I'm" },
      "body": {
        "ar": "I'm اختصار لـ I am. نقول I'm fine أو I'm good بدلاً من I am fine. نستخدم And you? لإعادة السؤال.",
        "fr": "I'm est la contraction de I am. On dit I'm fine ou I'm good. And you? sert à retourner la question.",
        "hi": "I'm, I am का संक्षिप्त रूप है। हम I'm fine या I'm good बोलते हैं। And you? से सवाल लौटाते हैं।",
        "en": "I'm is short for I am. Say I'm fine or I'm good. And you? returns the question."
      }
    }
  ],

